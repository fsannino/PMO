# ─── PostgreSQL ─────────────────────────────────────────────────────────
# Dev local com docker-compose:
DATABASE_URL="postgresql://collabz:collabz@localhost:5432/collabz?schema=public"
#
# Produção (Supabase): copie a "Connection string" → "URI" do painel
# do projeto em supabase.com (Settings → Database → Connection string).
# Use a versão "Connection pooling" (pgbouncer) para apps Vercel:
# DATABASE_URL="postgresql://postgres.xxxxx:SENHA@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# E para migrations (sem pooling), defina DIRECT_URL:
# DIRECT_URL="postgresql://postgres.xxxxx:SENHA@aws-0-region.pooler.supabase.com:5432/postgres"

# ─── NextAuth ───────────────────────────────────────────────────────────
# Em produção, gere com: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production-please"
# URL pública. Em produção: https://collabz.suaempresa.com
NEXTAUTH_URL="http://localhost:3000"

# ─── Supabase Storage (opcional, para Documents) ────────────────────────
# SUPABASE_URL="https://xxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJh..."
