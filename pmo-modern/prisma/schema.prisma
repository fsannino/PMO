// PMO Sinergia — modelo de domínio moderno
// Inspirado nos scripts SQL legados em /Scripts/Script_SMR.txt e Script_SMR_Light.txt
// e nas telas ASP de SMR/ e SMR_Light/ + forms VB6 em Manutencao_SMR/.
//
// SQLite em dev (sem suporte a enums) → enums viram String + validação Zod
// em src/lib/enums.ts. Em produção com PostgreSQL, reintroduzir enums nativos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// IDENTIDADE / RBAC
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("MEMBER") // Role: ADMIN/MANAGER/MEMBER/VIEWER
  unidadeId    String?
  unidade      Unidade? @relation(fields: [unidadeId], references: [id])
  areaId       String?
  area         Area?    @relation(fields: [areaId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   Membership[]
  accesses      Access[]
  measurements  Measurement[]
  comments      Comment[]
  ownedIssues   Issue[]         @relation("IssueOwner")
  ownedRisks    Risk[]          @relation("RiskOwner")
  ownedActions  Action[]        @relation("ActionOwner")
  ownedCRs      ChangeRequest[] @relation("CROwner")
  assignedTasks Task[]          @relation("TaskAssignee")
  taskHistories TaskHistory[]
  uploadedDocs  Document[]
  importLogs    ImportLog[]     @relation("ImportUser")
}

// ═══════════════════════════════════════════════════════════════════════════
// DADOS MESTRE
// ═══════════════════════════════════════════════════════════════════════════

model Unidade {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  projects Project[]
}

model Area {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  tasks  Task[]
  issues Issue[]
}

model Frente {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

model Governanca {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

model Comite {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeRequests ChangeRequest[]
}

model Equipe {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

// ═══════════════════════════════════════════════════════════════════════════
// PROJETO
// ═══════════════════════════════════════════════════════════════════════════

model Project {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  description   String?
  module        String      @default("PMO") // Module: CUT/GVI/GRF/TCP/TIN/PMO/LIGHT
  status        String      @default("ACTIVE") // ProjectStatus
  priority      Int         @default(0)
  unidadeId     String?
  unidade       Unidade?    @relation(fields: [unidadeId], references: [id])
  governancaId  String?
  governanca    Governanca? @relation(fields: [governancaId], references: [id])
  startDate     DateTime
  endDate       DateTime
  baselineDate  DateTime?
  ownerId       String
  owner         User        @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  members           Membership[]
  accesses          Access[]
  tasks             Task[]
  issues            Issue[]
  risks             Risk[]
  actions           Action[]
  changeRequests    ChangeRequest[]
  traceabilities    Traceability[]
  imports           ImportLog[]
  documents         Document[]
  configFechamentos ConfigFechamento[]
}

model Membership {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  role      String  @default("MEMBER")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Access {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  module    String   // Module
  canRead   Boolean  @default(true)
  canWrite  Boolean  @default(false)
  canAdmin  Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, module])
}

// ═══════════════════════════════════════════════════════════════════════════
// CRONOGRAMA
// ═══════════════════════════════════════════════════════════════════════════

model Task {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalId    String?
  wbs           String?
  name          String
  description   String?
  startDate     DateTime
  endDate       DateTime
  baselineStart DateTime?
  baselineEnd   DateTime?
  durationDays  Int?
  percentDone   Float     @default(0)
  status        String    @default("NOT_STARTED") // TaskStatus
  isMilestone   Boolean   @default(false)
  isSummary     Boolean   @default(false)
  parentId      String?
  parent        Task?     @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Task[]    @relation("TaskHierarchy")
  assigneeId    String?
  assignee      User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  areaId        String?
  area          Area?     @relation(fields: [areaId], references: [id])
  frenteId      String?
  frente        Frente?   @relation(fields: [frenteId], references: [id])
  equipeId      String?
  equipe        Equipe?   @relation(fields: [equipeId], references: [id])
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  predecessors     TaskDependency[]  @relation("Successor")
  successors       TaskDependency[]  @relation("Predecessor")
  measurements     Measurement[]
  measurementLocks MeasurementLock[]
  comments         Comment[]
  history          TaskHistory[]
  traceabilities   Traceability[]
  issues           Issue[]           @relation("IssueTask")

  @@index([projectId])
  @@index([assigneeId])
  @@index([deletedAt])
}

model TaskDependency {
  id            String @id @default(cuid())
  predecessorId String
  successorId   String
  type          String @default("FS") // DependencyType: FS/SS/FF/SF
  lagDays       Int    @default(0)

  predecessor Task @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("Successor",   fields: [successorId],   references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // HistoryAction: CREATED/UPDATED/DELETED/RESTORED/IMPORTED/MEASURED
  field     String?
  oldValue  String?
  newValue  String?
  note      String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ═══════════════════════════════════════════════════════════════════════════
// MEDIÇÃO + JANELA HB
// ═══════════════════════════════════════════════════════════════════════════

model Measurement {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        DateTime  @default(now())
  period      String
  percentDone Float
  hoursWorked Float?
  comment     String?
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([taskId])
  @@index([period])
}

model MeasurementLock {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  period        String
  lockedAt      DateTime @default(now())
  measurementId String?  @unique

  @@unique([taskId, period])
}

model ConfigFechamento {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  enabled   Boolean  @default(true)
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, dayOfWeek])
}

// ═══════════════════════════════════════════════════════════════════════════
// ISSUES, RISKS, ACTIONS, CHANGE REQUESTS
// ═══════════════════════════════════════════════════════════════════════════

model Issue {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?     @relation("IssueTask", fields: [taskId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?     @relation("IssueOwner", fields: [ownerId], references: [id])
  areaId      String?
  area        Area?     @relation(fields: [areaId], references: [id])
  externalId  String?
  title       String
  description String?
  severity    String    @default("MEDIUM") // Severity
  priority    String    @default("MEDIUM") // Priority
  status      String    @default("OPEN")   // IssueStatus
  workflow    String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  deletedAt   DateTime?
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
}

model Risk {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId     String?
  owner       User?     @relation("RiskOwner", fields: [ownerId], references: [id])
  externalId  String?
  title       String
  description String?
  probability Float     @default(0.5)
  impact      Float     @default(0.5)
  exposure    Float     @default(0.25)
  mitigation  String?
  status      String    @default("IDENTIFIED") // RiskStatus
  deletedAt   DateTime?
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
}

model Action {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId     String?
  owner       User?     @relation("ActionOwner", fields: [ownerId], references: [id])
  externalId  String?
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("OPEN")    // ActionStatus
  priority    String    @default("MEDIUM")  // Priority
  comments    Comment[]
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

model ChangeRequest {
  id          String                    @id @default(cuid())
  projectId   String
  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId     String?
  owner       User?                     @relation("CROwner", fields: [ownerId], references: [id])
  comiteId    String?
  comite      Comite?                   @relation(fields: [comiteId], references: [id])
  externalId  String?
  name        String
  description String?
  priority    String                    @default("MEDIUM") // Priority
  status      String                    @default("OPEN")   // ChangeRequestStatus
  dueDate     DateTime?
  comments    Comment[]
  increments  ChangeRequestIncrement[]
  alterations ChangeRequestAlteration[]
  deletedAt   DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([projectId])
}

model ChangeRequestIncrement {
  id              String        @id @default(cuid())
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  sequence        Int
  description     String
  appliedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@unique([changeRequestId, sequence])
}

model ChangeRequestAlteration {
  id              String        @id @default(cuid())
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  description     String
  changedField    String?
  oldValue        String?
  newValue        String?
  changedAt       DateTime      @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════
// TRACEABILITY
// ═══════════════════════════════════════════════════════════════════════════

model Traceability {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reqId     String
  testId    String?
  mapping   String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

// ═══════════════════════════════════════════════════════════════════════════
// COMENTÁRIOS
// ═══════════════════════════════════════════════════════════════════════════

model Comment {
  id              String         @id @default(cuid())
  body            String
  authorId        String
  author          User           @relation(fields: [authorId], references: [id])
  taskId          String?
  task            Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issueId         String?
  issue           Issue?         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  riskId          String?
  risk            Risk?          @relation(fields: [riskId], references: [id], onDelete: Cascade)
  actionId        String?
  action          Action?        @relation(fields: [actionId], references: [id], onDelete: Cascade)
  changeRequestId String?
  changeRequest   ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════
// DOCUMENTOS
// ═══════════════════════════════════════════════════════════════════════════

model Document {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  filename     String
  mimeType     String
  size         Int
  storagePath  String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([projectId])
}

// ═══════════════════════════════════════════════════════════════════════════
// IMPORTAÇÃO
// ═══════════════════════════════════════════════════════════════════════════

model ImportLog {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation("ImportUser", fields: [userId], references: [id])
  source      String   // ImportSource: EXCEL/MSPROJECT_XML/MANUAL
  template    String?  // ImportTemplate: IS/RK/AC/CR/TK/TC
  filename    String
  recordCount Int
  warnings    String?
  mode        String   @default("MERGE") // ImportMode: REPLACE/MERGE/ONLY_NEW
  createdAt   DateTime @default(now())

  @@index([projectId])
}
